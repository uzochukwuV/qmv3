    /// @notice Oracle proposes one canonical final score for a whole MarketGroup.
        function proposeGroupResult(
        uint64 groupId,
        uint16 homeScore,
        uint16 awayScore,
        uint256 sigDeadline,
        bytes calldata sig
    ) external onlyAuthorized {
        bytes32 proofHash = keccak256(abi.encodePacked(
            "legacy:proposeGroupResult",
            block.chainid,
            address(this),
            groupId,
            homeScore,
            awayScore,
            sigDeadline,
            sig
        ));
        _settleGroupWithProof(groupId, homeScore, awayScore, proofHash, "legacy:groupResult");
    }

    function adminOverrideGroupResult(
        uint64 groupId,
        uint16 homeScore,
        uint16 awayScore
    ) external onlyAdmin {
        bytes32 proofHash = keccak256(abi.encodePacked(
            "legacy:adminOverrideGroupResult",
            block.chainid,
            address(this),
            groupId,
            homeScore,
            awayScore
        ));
        _settleGroupWithProof(groupId, homeScore, awayScore, proofHash, "legacy:adminOverride");
    }

    function finalizeGroupResult(uint64) external {
        revert MarketNotSettled();
    }

    function _deriveScoreOutcome(
        Market storage m,
        uint16 homeScore,
        uint16 awayScore
    ) internal view returns (uint8) {
        if (m.settlementRule == SettlementRule.FTR) {
            if (homeScore > awayScore) return m.homeOutcomeId;
            if (awayScore > homeScore) return m.awayOutcomeId;
            return m.drawOutcomeId;
        }
        if (m.settlementRule == SettlementRule.BTTS) {
            return (homeScore > 0 && awayScore > 0) ? m.yesOutcomeId : m.noOutcomeId;
        }
        if (m.settlementRule == SettlementRule.TotalGoalsOver) {
            return (uint256(homeScore + awayScore) * 10 > m.settlementLine) ? m.overOutcomeId : m.underOutcomeId;
        }
        if (m.settlementRule == SettlementRule.TotalGoalsUnder) {
            return (uint256(homeScore + awayScore) * 10 < m.settlementLine) ? m.underOutcomeId : m.overOutcomeId;
        }
        revert InvalidMarketStatus();
    }

    function _finalizeMarket(uint64 marketId, uint8 winningOutcome) internal {
        Market storage m = markets[marketId];
        if (m.status != MarketStatus.Open && m.status != MarketStatus.Suspended && m.status != MarketStatus.AwaitingResult && m.status != MarketStatus.Proposed) {
            revert InvalidMarketStatus();
        }
        if (winningOutcome >= m.numOutcomes) revert InvalidMarketStatus();

        _unlockPayout(m.epochId, m.lockedPayout);
        m.lockedPayout = 0;
        m.status = MarketStatus.Settled;
        m.winningOutcome = winningOutcome;
        m.settlementTime = block.timestamp;

        Epoch storage ep = epochs[m.epochId];
        unchecked { ++ep.numSettledMarkets; }
        if (ep.numSettledMarkets >= ep.numMarkets) {
            ep.allMarketsSettled = true;
        }

        emit MarketFinalized(marketId, winningOutcome);
        emit MarketStatusChanged(marketId, MarketStatus.Settled);
    }

function postOddsWithProof(
        uint64 marketId,
        uint256[MAX_OUTCOMES] calldata newOdds,
        bytes32 proofHash,
        string memory proofId
    ) external onlyAuthorized whenNotPaused {
        Market storage m = markets[marketId];
        if (m.marketId == 0) revert InvalidMarketStatus();
        if (m.status != MarketStatus.Open && m.status != MarketStatus.PreOpen) {
            revert InvalidMarketStatus();
        }
        if (block.timestamp >= m.startTime) revert MarketAlreadyStarted();

        for (uint8 i = 0; i < m.numOutcomes; ) {
            if (newOdds[i] < LibOdds.MIN_ODDS) revert OddsBelowMinimum();
            if (!LibOdds.withinDeviation(newOdds[i], m.oddsAnchor[i], m.maxDeviationBps)) {
                revert OddsDeviationExceeded();
            }
            m.currentOdds[i] = newOdds[i];
            unchecked { ++i; }
        }

        m.oddsLastUpdated = block.timestamp;
        m.oddsProofHash = proofHash;
        marketOddsProofHash[marketId] = proofHash;

        emit OddsUpdated(marketId, newOdds, block.timestamp);
        emit OddsProofPosted(marketId, proofHash, proofId);
    }

    /// @notice Settle a market group immediately using the canonical Txodds proof reference.
    function settleGroupWithProof(
        uint64 groupId,
        uint16 homeScore,
        uint16 awayScore,
        bytes32 proofHash,
        string memory proofId
    ) external onlyAuthorized whenNotPaused {
        MarketGroup storage mg = marketGroups[groupId];
        if (!mg.exists) revert InvalidMarketStatus();
        if (mg.resultFinalized) revert MarketAlreadySettled();

        mg.homeScore = homeScore;
        mg.awayScore = awayScore;
        mg.resultFinalized = true;
        mg.settlementProofHash = proofHash;
        groupSettlementProofHash[groupId] = proofHash;

        uint8 n = mg.numMarkets;
        for (uint8 i = 0; i < n; ) {
            uint64 marketId = mg.marketIds[i];
            Market storage m = markets[marketId];
            if (m.settlementRule != SettlementRule.Manual) {
                uint8 outcome = _deriveScoreOutcome(m, homeScore, awayScore);
                _finalizeMarket(marketId, outcome);
            }
            unchecked { ++i; }
        }

        emit GroupSettlementProofPosted(groupId, proofHash, proofId);
        emit GroupFinalized(groupId, homeScore, awayScore);
    }
