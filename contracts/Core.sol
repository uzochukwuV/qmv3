    function _canonicalOutcomeCode(Market storage m, uint8 outcomeId) internal view returns (uint8) {
        if (m.settlementRule == SettlementRule.FTR) {
            if (outcomeId == m.homeOutcomeId) return 0; // home
            if (outcomeId == m.awayOutcomeId) return 1; // away
            if (outcomeId == m.drawOutcomeId) return 2; // draw
        }
        if (m.settlementRule == SettlementRule.BTTS) {
            if (outcomeId == m.yesOutcomeId) return 5; // gg
            if (outcomeId == m.noOutcomeId) return 6; // ng
        }
        if (m.settlementRule == SettlementRule.TotalGoalsOver || m.settlementRule == SettlementRule.TotalGoalsUnder) {
            if (outcomeId == m.overOutcomeId) return 3; // over
            if (outcomeId == m.underOutcomeId) return 4; // under
        }
        revert InvalidOutcomeId();
    }


    function _matchesOutcome(uint8 stateIndex, uint8 outcome) internal pure returns (bool) {
        if (outcome == 0) return stateIndex == 0 || stateIndex == 1 || stateIndex == 2;
        if (outcome == 1) return stateIndex == 3 || stateIndex == 4 || stateIndex == 5;
        if (outcome == 2) return stateIndex == 6 || stateIndex == 7 || stateIndex == 8;
        if (outcome == 3) return stateIndex == 0 || stateIndex == 2 || stateIndex == 3 || stateIndex == 5 || stateIndex == 8;
        if (outcome == 4) return stateIndex == 1 || stateIndex == 4 || stateIndex == 6 || stateIndex == 7;
        if (outcome == 5) return stateIndex == 0 || stateIndex == 3 || stateIndex == 6 || stateIndex == 8;
        if (outcome == 6) return stateIndex == 1 || stateIndex == 2 || stateIndex == 4 || stateIndex == 5 || stateIndex == 7;
        return false;
    }


    function _canonicalGroupOutcomeCount(GroupType marketType) internal view returns (uint8) {
        if (marketType == GroupType.FTR) return 3;
        if (marketType == GroupType.Goals) return 2;
        if (marketType == GroupType.BTTS) return 2;
        return 0;
    }

    function _isCanonicalFootballGroupMarket(GroupType marketType, SettlementRule settlementRule) internal pure returns (bool) {
        if (marketType == GroupType.FTR) return settlementRule == SettlementRule.FTR;
        if (marketType == GroupType.Goals) {
            return settlementRule == SettlementRule.TotalGoalsOver || settlementRule == SettlementRule.TotalGoalsUnder;
        }
        if (marketType == GroupType.BTTS) return settlementRule == SettlementRule.BTTS;
        return false;
    }


    function _marketCurrentOdds(Market storage m, uint8 outcomeId) internal view returns (uint256) {
        if (m.hasGroup) {
            MarketGroup storage mg = marketGroups[m.groupId];
            if (mg.pricingInitialized) {
                int256[9] memory q = mg.stateQ;
                return StateSpacePricing9(pricingEngine).outcomeOdds(q, mg.pricingB, _canonicalOutcomeCode(m, outcomeId));
            }
        }
        return m.currentOdds[outcomeId];
    }

    function _syncGroupPricing(uint64 groupId) internal {
        MarketGroup storage mg = marketGroups[groupId];
        if (!mg.pricingInitialized) return;

        int256[9] memory q = mg.stateQ;
        uint256 b = mg.pricingB;
        uint8 n = mg.numMarkets;
        for (uint8 i = 0; i < n; ) {
            uint64 marketId = mg.marketIds[i];
            Market storage m = markets[marketId];
            if (m.marketId != 0) {
                if (m.settlementRule == SettlementRule.FTR) {
                    m.currentOdds[m.homeOutcomeId] = StateSpacePricing9(pricingEngine).outcomeOdds(q, b, 0);
                    m.currentOdds[m.awayOutcomeId] = StateSpacePricing9(pricingEngine).outcomeOdds(q, b, 1);
                    m.currentOdds[m.drawOutcomeId] = StateSpacePricing9(pricingEngine).outcomeOdds(q, b, 2);
                } else if (m.settlementRule == SettlementRule.BTTS) {
                    m.currentOdds[m.yesOutcomeId] = StateSpacePricing9(pricingEngine).outcomeOdds(q, b, 5);
                    m.currentOdds[m.noOutcomeId] = StateSpacePricing9(pricingEngine).outcomeOdds(q, b, 6);
                } else if (m.settlementRule == SettlementRule.TotalGoalsOver || m.settlementRule == SettlementRule.TotalGoalsUnder) {
                    m.currentOdds[m.overOutcomeId] = StateSpacePricing9(pricingEngine).outcomeOdds(q, b, 3);
                    m.currentOdds[m.underOutcomeId] = StateSpacePricing9(pricingEngine).outcomeOdds(q, b, 4);
                }
            }
            unchecked { ++i; }
        }
    }

    function _applyGroupBuy(uint64 groupId, Market storage m, uint8 outcomeId, uint256 payout) internal {
        MarketGroup storage mg = marketGroups[groupId];
        if (!mg.pricingInitialized) return;
        uint8 canonical = _canonicalOutcomeCode(m, outcomeId);
        int256 delta = int256(payout * 1e12);
        for (uint8 s = 0; s < 9; ) {
            if ( _matchesOutcome(s, canonical)) {
                mg.stateQ[s] += delta;
            }
            unchecked { ++s; }
        }
        _syncGroupPricing(groupId);
    }

