    function getEpochStartTime(uint64 epochId) external view returns (uint256) {
        return epochs[epochId].startTime;
    }

    function getMarketSlipView(uint64 marketId) external view returns (MarketSlipView memory viewData) {
        Market storage m = markets[marketId];
        viewData.status = m.status;
        viewData.startTime = m.startTime;
        viewData.numOutcomes = m.numOutcomes;
        viewData.epochId = m.epochId;
        viewData.groupId = m.groupId;
        viewData.marketType = m.marketType;
        viewData.currentOdds = m.currentOdds;
        viewData.volumeCap = m.volumeCap;
        viewData.volumeFilled = m.volumeFilled;
        viewData.slipVolumeFilled = m.slipVolumeFilled;
        viewData.winningOutcome = m.winningOutcome;
    }

    function getEpochSlipView(uint64 epochId) external view returns (EpochSlipView memory viewData) {
        Epoch storage ep = epochs[epochId];
        viewData.totalLiquidityAdded = ep.totalLiquidityAdded;
        viewData.maxExposureMultiplierBps = ep.maxExposureMultiplierBps;
        viewData.totalLockedPayouts = ep.totalLockedPayouts;
    }


    /// @notice Create a new MarketGroup (the real-world event / match).
    function _verifyCreateMarketSig(CreateMarketParams calldata) internal pure {}

    function _autoVolumeCap(Epoch storage ep, uint8 numOutcomes) internal view returns (uint256) {
        if (numOutcomes == 0) return 0;
        return LibOdds.maxEpochExposure(ep.totalLiquidityAdded, ep.maxExposureMultiplierBps) / numOutcomes;
    }

    function createMarketGroup(
        string   calldata title,
        uint256  eventStartTime,
        uint256  maxGroupExposure
    ) external onlyAuthorized returns (uint64 groupId) {
        if (!epochs[currentEpoch].initialized) revert EpochNotInitialized();
        groupId = _nextGroupId();

        MarketGroup storage mg = marketGroups[groupId];
        mg.groupId          = groupId;
        mg.creator          = msg.sender;
        mg.title            = title;
        mg.eventStartTime   = eventStartTime;
        mg.maxGroupExposure = maxGroupExposure > 0 ? maxGroupExposure : maxMarketExposure;
        mg.currentExposure  = 0;
        mg.numMarkets       = 0;
        mg.exists           = true;

        emit MarketGroupCreated(groupId, title, eventStartTime);
    }

    /// @notice Seed the 9-state book for a 3-market football group.
    function seedGroupPricing(
        uint64 groupId,
        uint256 bWad,
        uint256[9] calldata initialStateProbabilitiesWad
    ) external onlyAuthorized {
        MarketGroup storage mg = marketGroups[groupId];
        if (!mg.exists) revert GroupNotFound();
        if (mg.pricingInitialized) revert InvalidMarketStatus();
        if (mg.numMarkets != 3) revert InvalidMarketStatus();

        uint256 total;
